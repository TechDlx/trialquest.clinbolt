# Caddy site config for quest.clinbolt.com (Trial Quest)
# Installed by caddy_site.sh to /etc/caddy/sites/quest.caddy, which the main
# /etc/caddy/Caddyfile imports alongside the other clinbolt sites on this VM.
#
# Caddy obtains and renews the TLS certificate from Let's Encrypt automatically,
# provided DNS points here and ports 80 and 443 are reachable (see DEPLOY.md).

quest.clinbolt.com {
	root * /var/www/quest.clinbolt.com
	encode zstd gzip

	# --- security headers -------------------------------------------------
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

		# The build is self-contained apart from Google Analytics (GA4): its
		# loader comes from googletagmanager.com and hits go to google-analytics.com,
		# google.com/g/collect and g.doubleclick.net (Google's documented GA4 hosts).  The one inline <script> is the Google
		# tag in index.html, allowed by its sha256 only; if that script changes,
		# update the hash (src/app/analytics.test.ts fails until they match).
		# style-src keeps 'unsafe-inline' because framer-motion animates through
		# style attributes.  The service worker and manifest are same-origin.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-GczIEnVrJOxuYTU35Es10/oshUotYHVeMROF+I1FemE=' https://*.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

		-Server
	}

	# --- caching ----------------------------------------------------------
	# Vite content-hashes everything under /assets/, so it never changes.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, sw.js, the manifest, icons) must be
	# revalidated, or installed copies of the PWA keep running an old build.
	@revalidate not path /assets/*
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	# --- serving ----------------------------------------------------------
	# The app uses hash routing, so only "/" is a real page.  Any other unknown
	# path gets the app shell; a missing asset still 404s rather than returning
	# HTML that the service worker would cache as a script.
	handle /assets/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}

	# Don't let a 404 inherit the year-long asset caching above.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}

	log {
		output file /var/log/caddy/quest.clinbolt.com.log {
			roll_size 10mb
			roll_keep 5
		}
		format console
	}
}
