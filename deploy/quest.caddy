# Caddy site config for quest.clinbolt.com (Trial Quest)
# Installed by caddy_site.sh to /etc/caddy/sites/quest.caddy, which the main
# /etc/caddy/Caddyfile imports alongside the other clinbolt sites on this VM.
#
# Caddy obtains and renews the TLS certificate from Let's Encrypt automatically,
# provided DNS points here and ports 80 and 443 are reachable (see DEPLOY.md).

quest.clinbolt.com {
	root * /var/www/quest.clinbolt.com
	encode zstd gzip

	# --- security headers -------------------------------------------------
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"

		# The build is fully self-contained: no CDN, no third-party requests and
		# no inline <script>.  style-src keeps 'unsafe-inline' because
		# framer-motion animates through style attributes.  The service worker
		# and manifest are same-origin.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

		-Server
	}

	# --- caching ----------------------------------------------------------
	# Vite content-hashes everything under /assets/, so it never changes.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, sw.js, the manifest, icons) must be
	# revalidated, or installed copies of the PWA keep running an old build.
	@revalidate not path /assets/*
	header @revalidate Cache-Control "public, max-age=0, must-revalidate"

	# --- serving ----------------------------------------------------------
	# The app uses hash routing, so only "/" is a real page.  Any other unknown
	# path gets the app shell; a missing asset still 404s rather than returning
	# HTML that the service worker would cache as a script.
	handle /assets/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}

	# Don't let a 404 inherit the year-long asset caching above.
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}

	log {
		output file /var/log/caddy/quest.clinbolt.com.log {
			roll_size 10mb
			roll_keep 5
		}
		format console
	}
}
